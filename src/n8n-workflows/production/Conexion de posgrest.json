        "query": "SELECT\n  c.id_caso_dengue,\n  c.ubigeo,\n  p.anio,\n  p.semana,\n  c.id_diresa,\n  c.enfermedad,\n  c.diagnostic,\n  c.edad,\n  c.tipo_edad,\n  c.sexo\nFROM caso_dengue c\nJOIN periodo_epidemiologico p ON p.id_periodo = c.id_periodo\nWHERE ({{ $json.body.departamento ? \"LEFT(c.ubigeo, 2) = '\" + $json.body.departamento + \"'\" : \"1=1\" }})\n  AND ({{ $json.body.anio ? \"p.anio = \" + Number($json.body.anio) : \"1=1\" }})\nORDER BY c.id_caso_dengue\nLIMIT 100 OFFSET {{ (Number($json.body.pagina || 1) - 1) * 100 }};",
