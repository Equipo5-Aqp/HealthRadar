        "query": "SELECT\n  {{ $json.body.anio ? \"p.semana\" : \"p.anio\" }} AS periodo,\n  COUNT(c.id_caso_dengue) AS total_casos\nFROM periodo_epidemiologico p\nLEFT JOIN caso_dengue c\n  ON c.id_periodo = p.id_periodo\n  AND ($1 = '' OR LEFT(c.ubigeo, 2) = $1)\nWHERE ($2::int = 0 OR p.anio = $2::int)\nGROUP BY {{ $json.body.anio ? \"p.semana\" : \"p.anio\" }}\nORDER BY {{ $json.body.anio ? \"p.semana\" : \"p.anio\" }};",
