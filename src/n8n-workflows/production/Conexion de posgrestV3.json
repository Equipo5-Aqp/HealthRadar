      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.id_caso_dengue,\n  c.ubigeo,\n  p.anio,\n  p.semana,\n  c.id_diresa,\n  c.enfermedad,\n  c.diagnostic,\n  c.edad,\n  c.tipo_edad,\n  c.sexo\nFROM caso_dengue c\nJOIN periodo_epidemiologico p ON p.id_periodo = c.id_periodo\nWHERE ($1 = '' OR LEFT(c.ubigeo, 2) = $1)\n  AND ($2::int = 0 OR p.anio = $2::int)\nORDER BY c.id_caso_dengue\nLIMIT 100 OFFSET (($3::int - 1) * 100);",
