              "value": "-77.04,-77.87,-77.53,-72.88,-71.54,-74.22,-78.51,-77.12,-71.97,-74.97,-76.24,-75.73,-75.21,-79.03,-79.84,-73.25,-69.19,-70.93,-76.26,-80.63,-70.02,-76.37,-70.25,-80.45,-74.55"
            },
