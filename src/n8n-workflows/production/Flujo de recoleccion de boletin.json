    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const responses = Array.isArray(item.json) ? item.json : [item.json];\n  \n  for (const response of responses) {\n    const data = response.daily;\n    if (!data || !data.time) continue;\n    \n    const promedio = arr => (arr.reduce((a, b) => a + b, 0) / arr.length).toFixed(1);\n    const suma = arr => arr.reduce((a, b) => a + b, 0).toFixed(1);\n    \n    output.push({\n      json: {\n        latitud: response.latitude,\n        longitud: response.longitude,\n        semana_inicio: data.time[0],\n        semana_fin: data.time[data.time.length - 1],\n        temp_max_promedio: Number(promedio(data.temperature_2m_max)),\n        temp_min_promedio: Number(promedio(data.temperature_2m_min)),\n        precipitacion_total: Number(suma(data.precipitation_sum))\n      }\n    });\n  }\n}\n\nreturn output;"
      },
