      "parameters": {
        "jsCode": "// Rechazo unico: nunca dice si fallo el secreto, el correo, la contrasena o el bloqueo.\nconst { RESPUESTA_NO_AUTORIZADO } = require('@healthradar/core');\nconst formato = $input.first().json.estado === 'formato';\nconst cuerpo = formato\n  ? { ok: false, error: true, codigo: 'FORMATO_INVALIDO', mensaje: 'Solicitud invalida' }\n  : RESPUESTA_NO_AUTORIZADO;\nreturn [{ json: { formato, cuerpo } }];"
