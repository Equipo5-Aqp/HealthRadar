          "name": "Postgres account"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Una sola sentencia: reinicia el contador, crea la sesion y deja el evento en la bitacora."
    },
    {
      "parameters": {
        "jsCode": "// El token sale solo hacia mf-consulta, que lo pone en una cookie HttpOnly.\nconst core = require('@healthradar/core');\nconst r = $input.first().json;\nif (!r || r.id_usuario === undefined || r.id_usuario === null) throw new Error('sin fila de sesion');\nconst s = $('Generar sesión (core)').first().json;\nreturn [{ json: { cuerpo: core.construirRespuestaLogin({ token: s.token, email: r.email, rol: r.rol, expiraEnSeg: s.expira_en_seg }) } }];"
      },
