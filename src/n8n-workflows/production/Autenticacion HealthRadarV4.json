      "parameters": {
        "jsCode": "const core = require('@healthradar/core');\nconst v = $('Validar login (core)').first().json;\nconst filas = $input.all().map(i => i.json).filter(f => f && f.id_usuario !== undefined && f.id_usuario !== null);\nreturn [{ json: { motivo: core.motivoFallo(filas), id_usuario: filas[0] ? String(filas[0].id_usuario) : '',\n  email: v.email, ip: v.ip, user_agent: v.user_agent } }];"
