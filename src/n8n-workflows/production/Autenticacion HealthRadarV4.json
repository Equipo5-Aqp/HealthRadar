    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (SELECT * FROM fn_usuario_registrar_exito($1::text)),\n     s AS (SELECT * FROM fn_sesion_crear($2::text, (SELECT id_usuario FROM u), $3::int,\n                                         NULLIF($4::text, ''), NULLIF($5::text, ''))),\n     e AS (INSERT INTO login_evento (id_usuario, email_intento, exito, motivo, ip, user_agent)\n           SELECT u.id_usuario, $1::text, TRUE, 'ok', NULLIF($4::text, ''), NULLIF($5::text, '') FROM u\n           RETURNING id_evento)\nSELECT u.id_usuario, u.email, u.rol, s.expira_at FROM u CROSS JOIN s;",
        "options": {
          "queryReplacement": "={{ [ $json.email, $json.token_hash, $json.ttl_minutos, $('Validar login (core)').first().json.ip, $('Validar login (core)').first().json.user_agent ] }}"
        }
      },
