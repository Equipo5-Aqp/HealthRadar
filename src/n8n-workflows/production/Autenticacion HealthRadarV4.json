      "parameters": {
        "jsCode": "// Secreto compartido (mf-consulta -> n8n) + formato de credenciales. Falla cerrado: sin AUTH_WEBHOOK_SECRET nadie entra.\nconst core = require('@healthradar/core');\nconst e = $input.first().json;\nconst h = e.headers || {};\nconst b = e.body || {};\nif (!core.compararSecreto(h['x-auth-secret'], $env.AUTH_WEBHOOK_SECRET)) return [{ json: { estado: 'no_autorizado' } }];\nconst c = core.validarCredenciales(b);\nif (!c.valido) return [{ json: { estado: 'formato' } }];\nconst pol = core.normalizarPolitica({ maxIntentos: $env.AUTH_MAX_INTENTOS, bloqueoMinutos: $env.AUTH_BLOQUEO_MINUTOS });\nreturn [{ json: { estado: 'ok', email: c.email, password: c.password,\n  ip: core.normalizarIp(b.ip) || '', user_agent: core.normalizarUserAgent(b.user_agent) || '', ...pol } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Validar login (core)",
      "notesInFlow": true,
      "position": [
        384,
        432
      ],
      "id": "845184aa-fe06-4f74-8f73-26c7b8e99b86",
      "notes": "La contrasena pasa por aqui en claro: este flujo NO debe guardar ejecuciones (ver Settings) ni tener nodos Log."
    },
