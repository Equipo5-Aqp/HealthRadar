    {
      "parameters": {
        "jsCode": "// Token opaco de 256 bits; a la base solo va su SHA-256.\nconst core = require('@healthradar/core');\nconst u = $input.first().json;\nconst s = core.generarSesion({ ttlMinutos: $env.AUTH_SESION_MINUTOS });\nreturn [{ json: { ...s, id_usuario: u.id_usuario, email: u.email, rol: u.rol } }];"
      },
      "type": "n8n-nodes-base.code",
