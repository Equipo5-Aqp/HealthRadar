        "query": "SELECT\n  COUNT(*)::int AS total,\n  COUNT(*) FILTER (WHERE resumen LIKE '%[CIFRAS:%')::int AS con_cifras\nFROM boletin_descubierto\nWHERE procesado = TRUE\n  AND resumen <> '';",
