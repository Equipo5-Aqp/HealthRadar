      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  anio,\n  semana_epidemiologica AS semana,\n  fecha_publicacion::text AS fecha_publicacion,\n  resumen\nFROM boletin_descubierto\nWHERE procesado = TRUE\n  AND resumen <> ''\nORDER BY anio DESC, semana_epidemiologica DESC\nLIMIT 150;",
