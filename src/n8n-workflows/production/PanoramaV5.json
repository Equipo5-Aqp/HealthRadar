    {
      "parameters": {
        "jsCode": "const { construirPanorama, construirFrescura } = require('@healthradar/core');\nconst filtros = $('Validar entrada').first().json.filtros;\nconst filas = $('Boletines procesados').all().map(i => i.json);\nconst conteos = $('Conteos').first().json;\nconst r = construirPanorama(filas, filtros, conteos);\nif (r.ok) {\n  try {\n    const f = $('Frescura de datos').first().json || {};\n    r.frescura = construirFrescura({\n      boletin_procesado: filas.length ? filas[0] : null,\n      ultimo_descubierto: f.ultimo_descubierto,\n      pendientes: f.pendientes,\n      clima: f.clima,\n      cargas: f.cargas,\n    }, new Date());\n  } catch (e) { r.frescura = null; }\n}\nreturn [{ json: r }];"
      },
