    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT row_to_json(t) FROM (\n     SELECT anio, semana_epidemiologica AS semana, fecha_publicacion::text AS fecha_publicacion\n     FROM boletin_descubierto\n     ORDER BY anio DESC, semana_epidemiologica DESC\n     LIMIT 1) t) AS ultimo_descubierto,\n  (SELECT COUNT(*)::int FROM boletin_descubierto WHERE procesado = FALSE) AS pendientes,\n  (SELECT row_to_json(t) FROM (\n     SELECT p.anio, p.semana\n     FROM dato_climatico d\n     JOIN periodo_epidemiologico p ON p.id_periodo = d.id_periodo\n     ORDER BY p.anio DESC, p.semana DESC\n     LIMIT 1) t) AS clima,\n  (SELECT COALESCE(json_agg(t), '[]'::json) FROM (\n     SELECT dataset, MAX(anio) AS hasta_anio, MAX(fecha_ejecucion)::text AS ultima_carga\n     FROM control_carga\n     WHERE estado = 'COMPLETADO' AND anio IS NOT NULL\n     GROUP BY dataset\n     ORDER BY dataset) t) AS cargas;",
        "options": {}
      },
