      "parameters": {
        "jsCode": "// Sprint 3 (ADR-012): la logica vive en @healthradar/core (construirPanorama).\n// Las cifras salen del marcador [CIFRAS] que valida Fase B; aqui no se calcula nada.\nconst { construirPanorama } = require('@healthradar/core');\nconst filtros = $('Validar entrada').first().json.filtros;\nconst filas = $('Boletines procesados').all().map(i => i.json);\nconst conteos = $('Conteos').first().json;\nreturn [{ json: construirPanorama(filas, filtros, conteos) }];"
      },
