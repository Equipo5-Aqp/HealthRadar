        "jsCode": "// El body del webhook es entrada NO confiable: se valida con @healthradar/core.\n// Las queries no reciben ningun valor del usuario; el filtrado por anio/semana se hace en el core.\nconst { validarFiltrosPanorama } = require('@healthradar/core');\nconst r = validarFiltrosPanorama($input.first().json.body);\nreturn [{ json: { filtros: r.filtros, _valido: r.valido, _error: r.error } }];"
