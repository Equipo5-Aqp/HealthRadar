    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  d.id_departamento AS codigo_departamento,\n  d.nombre AS departamento,\n  COALESCE(x.total_casos, 0)::int AS total_casos\nFROM departamento d\nLEFT JOIN (\n  SELECT LEFT(c.ubigeo, 2) AS cod, COUNT(*) AS total_casos\n  FROM caso_dengue c\n  JOIN periodo_epidemiologico p ON p.id_periodo = c.id_periodo\n  WHERE ($1::int = 0 OR p.anio = $1::int)\n  GROUP BY LEFT(c.ubigeo, 2)\n) x ON x.cod = d.id_departamento\nORDER BY d.id_departamento;",
        "options": {
          "queryReplacement": "={{ [ $json.body.anio ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
