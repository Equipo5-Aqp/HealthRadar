        "jsCode": "// Sprint 3 (ADR-012): el filtrado vive en @healthradar/core (filtrarNuevos).\nconst { filtrarNuevos } = require('@healthradar/core');\nconst nuevos = filtrarNuevos(\n  $('Extraer links + fecha/semana (dedup)').all().map(i => i.json),\n  $('Get row(s) boletines_descubiertos').all().map(i => i.json)\n);\nif (nuevos.length === 0) return [{ json: { _sinPendientes: true } }];\nreturn nuevos.map(json => ({ json: { ...json, _sinPendientes: false } }));"
