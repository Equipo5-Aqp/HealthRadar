    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const data = item.json.daily;\n  \n  if (!data || !data.time) {\n    continue;\n  }\n\n  for (let i = 0; i < data.time.length; i++) {\n    output.push({\n      json: {\n        fecha: data.time[i],\n        temp_max: data.temperature_2m_max[i],\n        temp_min: data.temperature_2m_min[i],\n        precipitacion: data.precipitation_sum[i]\n      }\n    });\n  }\n}\n\nreturn output;"
      },
