# Variables de entorno de Infraestructura - HealthRadar
# Copiar este archivo a .env para desarrollo local

# Base de Datos (PostgreSQL 16 + pgvector)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=healthradar_db
POSTGRES_PORT=5432

# n8n Self-Hosted
N8N_HOST=
N8N_PORT=5678
N8N_ENCRYPTION_KEY=n8n-key

# Arize Phoenix Observabilidad LLM (ADR-010)
PHOENIX_ENABLE_AUTH=false
PHOENIX_SECRET=phoenix-key

# Frontend Next.js (ADR-004)
PORT=3000

# Proveedores de Modelos de Lenguaje (ADR-003)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_API_KEY_2=tu_api_key_de_google_ai_studio
GEMINI_API_KEY_3=tu_api_key_de_google_ai_studio
NVIDIA_API_KEY=nvapi-TU_CLAVE_AQUI

# System Prompts para Workflows de n8n (opcional / inyectable desde entorno)
SYSTEM_PROMPT_CONEXION=
SYSTEM_PROMPT_FASE_B=