# Variables de entorno de Infraestructura - HealthRadar
# Copiar este archivo a .env para desarrollo local

# Base de Datos (PostgreSQL 16 + pgvector)
POSTGRES_USER=healthradar_admin
POSTGRES_PASSWORD=HealthRadar2026_SecuredSecret!
POSTGRES_DB=healthradar_db
POSTGRES_PORT=5432

# n8n Self-Hosted
N8N_HOST=n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=n8n_super_secret_encryption_key_2026

# Langfuse Observabilidad
LANGFUSE_NEXTAUTH_SECRET=langfuse_nextauth_secret_2026_key
LANGFUSE_SALT=langfuse_salt_secret_key_2026

# Frontend Next.js
PORT=3000
